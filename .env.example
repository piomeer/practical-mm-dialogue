# Unsplash Access Key（勿提交到 git）
# 申请：https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=

# Pexels API Key（勿提交到 git）
# 申请：https://www.pexels.com/api/
PEXELS_API_KEY=

# 阿里云 DashScope（千问 OpenAI 兼容接口）
# 控制台：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# 可选：Hugging Face Hub token（提高限速，PlotQA/DocVQA 等大包下载更稳）
# https://huggingface.co/settings/tokens
# HF_TOKEN=

# NAS 冷存根目录（先在 Finder 连接 smb://192.168.31.13/家庭共享 ）
# 挂载后常见路径如下；若卷名不同请改成实际路径
NAS_ROOT=/Volumes/家庭共享/实用多轮对话类图文数据集
# SMB URI（给人/Agent 看）：smb://192.168.31.13/家庭共享/实用多轮对话类图文数据集
